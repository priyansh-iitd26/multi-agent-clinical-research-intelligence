# Virtual environment — never commit this
.venv/

# Environment variables — contains API keys and secrets
.env

# Python cache files — auto-generated, not needed in git
__pycache__/
*.py[cod]
*.pyo

# Raw and processed data — too large for git, lives in Cloud Storage
data/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# VS Code settings
.vscode/

# macOS junk
.DS_Store

# Logs
*.log
